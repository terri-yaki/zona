{
  "expo": {
    "name": "Zona",
    "slug": "zona",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "zona",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/571437d3-1919-4bb5-870c-587bc7b59ef9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.terriyaki.zona",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F6B5F",
          "sounds": [
            "./assets/sounds/zona-soft.wav",
            "./assets/sounds/zona-bright.wav",
            "./assets/sounds/zona-urgent.wav",
            "./assets/sounds/zona-chime.wav",
            "./assets/sounds/zona-crystal.wav",
            "./assets/sounds/zona-warm.wav",
            "./assets/sounds/zona-pulse.wav",
            "./assets/sounds/zona-signal.wav",
            "./assets/sounds/zona-bloom.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-live-activity",
        {
          "enablePushNotifications": false
        }
      ],
      "./plugins/with-zona-live-activity-symbol.cjs",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "zh-Hant"],
            "android": ["en", "zh-Hant"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "571437d3-1919-4bb5-870c-587bc7b59ef9"
      }
    },
    "owner": "terriyaki"
  }
}
