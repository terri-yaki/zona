      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.terriyaki.zona.widgets",
          "groupIdentifier": "group.com.terriyaki.zona",
          "widgets": [
            {
              "name": "ZonaInboxWidget",
              "displayName": "Zona Inbox",
              "description": "See unread alerts and the latest source at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "./plugins/with-zona-shortcuts.cjs",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-live-activity",
        {
          "enablePushNotifications": false
        }
      ],
      "./plugins/with-zona-live-activity-symbol.cjs",
      [
        "expo-localization",
        {
          "supportedLocales": {
